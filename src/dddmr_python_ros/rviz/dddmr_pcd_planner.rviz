Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.18
      Class: rviz_default_plugins/PointCloud2
      Autocompute Intensity Bounds: true
      Channel Name: intensity
      Color Transformer: Intensity
      Max Color: 230; 230; 230
      Min Color: 70; 70; 70
      Enabled: true
      Name: Raw PCD
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /dddmr/map_points
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Autocompute Intensity Bounds: true
      Channel Name: intensity
      Color Transformer: Intensity
      Max Color: 230; 230; 230
      Min Color: 70; 70; 70
      Enabled: true
      Name: Traversable
      Size (Pixels): 5
      Size (m): 0.06
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /dddmr/traversable
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Autocompute Intensity Bounds: true
      Channel Name: intensity
      Color Transformer: Intensity
      Max Color: 230; 230; 230
      Min Color: 70; 70; 70
      Enabled: true
      Name: Lethal
      Size (Pixels): 4
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /dddmr/lethal
    - Alpha: 0.7
      Class: rviz_default_plugins/PointCloud2
      Autocompute Intensity Bounds: true
      Channel Name: intensity
      Color Transformer: Intensity
      Max Color: 230; 230; 230
      Min Color: 70; 70; 70
      Enabled: true
      Name: Obstacles
      Size (Pixels): 3
      Size (m): 0.04
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /dddmr/obstacles
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 30; 160; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: Global Path
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /global_path
  Enabled: true
  Global Options:
    Background Color: 38; 38; 38
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 50
      Focal Point:
        X: 3.3
        Y: 0.2
        Z: 4.8
      Pitch: 0.65
      Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1500
