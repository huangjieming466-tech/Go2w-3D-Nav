+  bool SCANReplanFSM::commandWouldCollide(const geometry_msgs::msg::Twist &command) const
+  {
+    if (!have_odom_ || !planner_manager_ || !planner_manager_->grid_map_)
+      return true;
+
+    Eigen::Vector3d pose = odom_pos_;
+    double yaw = getOdomYaw();
+    const double dt = std::max(0.01, command_safety_dt_);
+    const double horizon = std::max(dt, command_safety_horizon_);
+    for (double elapsed = 0.0; elapsed < horizon; elapsed += dt)
+    {
+      const double c = std::cos(yaw);
+      const double s = std::sin(yaw);
+      pose.x() += (c * command.linear.x - s * command.linear.y) * dt;
+      pose.y() += (s * command.linear.x + c * command.linear.y) * dt;
+      yaw = std::atan2(std::sin(yaw + command.angular.z * dt),
+                       std::cos(yaw + command.angular.z * dt));
+      // Any occupied or out-of-local-map prediction is unsafe. GridMap adds
+      // the configured body-height offset and validates both Go2W circles.
+      if (planner_manager_->grid_map_->getInflateOccupancy(pose, yaw) != 0)
+        return true;
+    }
+    return false;
+  }
+
+  void SCANReplanFSM::rawCommandCallback(geometry_msgs::msg::Twist::ConstSharedPtr msg)
+  {
+    if (!msg)
+      return;
+
+    if (exec_state_ != EXEC_TRAJ)
+    {
+      std_msgs::msg::Bool collision_msg;
+      collision_msg.data = false;
+      command_collision_pub_->publish(collision_msg);
+      command_collision_active_ = false;
+      command_collision_replan_requested_ = false;
+      safe_cmd_pub_->publish(geometry_msgs::msg::Twist());
+      return;
+    }
+
+    const rclcpp::Time now = node_->now();
+    const bool collision = command_safety_enabled_ && commandWouldCollide(*msg);
+    std_msgs::msg::Bool collision_msg;
+    collision_msg.data = collision;
+    command_collision_pub_->publish(collision_msg);
+
+    if (!collision)
+    {
+      // The controller can interleave a zero command with a blocked motion
+      // command. Keep the collision episode alive briefly so those zeros do
+      // not prevent the debounce timer from requesting a replan.
+      const double release_delay = std::max(0.25, 2.0 * command_safety_dt_);
+      if (command_collision_active_ &&
+          (now - last_command_collision_time_).seconds() >= release_delay)
+      {
+        command_collision_active_ = false;
+      }
+      safe_cmd_pub_->publish(*msg);
+      return;
+    }
+
+    // Do not permit a stale time-driven target to produce even a short motion
+    // into the current inflated map. Replanning is debounced below.
+    safe_cmd_pub_->publish(geometry_msgs::msg::Twist());
+    if (!command_collision_active_)
+    {
+      command_collision_active_ = true;
+      command_collision_first_time_ = now;
+      last_command_collision_time_ = now;
+    }
+    else
+    {
+      last_command_collision_time_ = now;
+    }
+
+    if ((now - last_command_collision_log_time_).seconds() >= 1.0)
+    {
+      RCLCPP_WARN(node_->get_logger(), "Command safety veto: predicted Go2W footprint collision");
+      last_command_collision_log_time_ = now;
+    }
+
+    if (exec_state_ == EXEC_TRAJ &&
+        (now - command_collision_first_time_).seconds() >= command_safety_replan_delay_ &&
+        (now - last_command_collision_replan_time_).seconds() >= command_safety_replan_cooldown_)
+    {
+      command_collision_replan_requested_ = true;
+      last_command_collision_replan_time_ = now;
+    }
+  }
 
